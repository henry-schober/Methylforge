/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test,<docker/singularity> 

----------------------------------------------------------------------------------------
*/

params {
    
    config_profile_name        = 'Dorado_test'
    config_profile_description = 'Test config for Dorado methylation calling pipeline'

    // required workflow inputs

    outdir = 'test'
    input = 'samplesheet.csv'

    //model options
    pore_type = "r10.4.1"            
    chemistry_type = "e8.2"       
    translocation_speed = "400bps"  
    model_version = "v5.0.0"        
    model_type = "sup"
    modification_name = "5mCG_5hmCG"    
    modification_version = "v3"     
    
    base_model_name = "dna_r9.4.1_e8_sup@v3.3"
    mod_model_name  = "dna_r9.4.1_e8_sup@v3.3_5mCG_5hmCG@v0"
    modeldir = "${params.outdir}/dorado/download/models"
    // modeldir = '/home/FCAM/hschober/methyl_pipeline/MethylForge/qc-nf/dorado/models'  // path to directory where I want models to be downloaded

    pod5_file = "/home/FCAM/hschober/methyl_pipeline/test_data/fast5_fail/"

    email  = ''

    

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_memory = '5.GB'
    max_time   = '1.h'
    
}
